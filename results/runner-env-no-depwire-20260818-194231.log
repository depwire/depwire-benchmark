g_start = paren_start\n        while arg_start < len(content) and content[arg_start] in ' \\t\\n\\r':\n            arg_start += 1\n        \n        # Try to extract message text (first arg)\n        message_text = \"\"\n        status_text = \"\"\n        \n        if arg_start < len(content):\n            ch = content[arg_start]\n            if ch == \"'\" or ch == '\"':\n                # Simple string literal\n                j = arg_start + 1\n                while j < len(content):\n                    if content[j] == '\\\\':\n                        j += 2\n                        continue\n                    if content[j] == ch:\n                        break\n                    j += 1\n                message_text = content[arg_start+1:j]\n            elif ch == '`':\n                # Template literal\n                j = arg_start + 1\n                depth = 0\n                while j < len(content):\n                    if content[j] == '\\\\':\n                        j += 2\n                        continue\n                    if content[j] == '$' and j+1 < len(content) and content[j+1] == '{':\n                        depth += 1\n                        j += 2\n                        continue\n                    if content[j] == '}' and depth > 0:\n                        depth -= 1\n                        j += 1\n                        continue\n                    if content[j] == '`' and depth == 0:\n                        break\n                    j += 1\n                message_text = content[arg_start+1:j]\n        \n        # Find status (second arg) by finding first comma at depth 0\n        depth = 0\n        in_string = None\n        j = arg_start\n        while j < len(content) and j < paren_start + 2000:\n            c = content[j]\n            if in_string:\n                if c == '\\\\':\n                    j += 2\n                    continue\n                if c == in_string:\n                    if in_string == '`':\n                        # Check template depth\n                        in_string = None\n                    else:\n                        in_string = None\n            else:\n                if c in (\"'\", '\"', '`'):\n                    in_string = c\n                elif c == '(':\n                    depth += 1\n                elif c == ')':\n                    if depth == 0:\n                        break\n                    depth -= 1\n                elif c == ',' and depth == 0:\n                    # Found first comma - extract status\n                    status_start = j + 1\n                    while status_start < len(content) and content[status_start] in ' \\t\\n\\r':\n                        status_start += 1\n                    # Read until next comma or close paren at depth 0\n                    status_end = status_start\n                    sd = 0\n                    ss = None\n                    while status_end < len(content):\n                        sc = content[status_end]\n                        if ss:\n                            if sc == '\\\\':\n                                status_end += 2\n                                continue\n                            if sc == ss:\n                                ss = None\n                        else:\n                            if sc in (\"'\", '\"', '`'):\n                                ss = sc\n                            elif sc == '(':\n                                sd += 1\n                            elif sc == ')':\n                                if sd == 0:\n                                    break\n                                sd -= 1\n                            elif sc == ',' and sd == 0:\n                                break\n                        status_end += 1\n                    status_text = content[status_start:status_end].strip()\n                    break\n            j += 1\n        \n        # Determine error code\n        error_code = determine_erro