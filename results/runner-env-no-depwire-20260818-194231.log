ead()\nc = c.replace(\n    \"\"\"    super(\n      t ? t('error:noFilesUploaded') : en.translations.error.noFilesUploaded,\n      httpStatus.BAD_REQUEST,\n    )\"\"\",\n    \"\"\"    super(\n      'MISSING_FILE',\n      t ? t('error:noFilesUploaded') : en.translations.error.noFilesUploaded,\n      httpStatus.BAD_REQUEST,\n    )\"\"\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated MissingFile.ts\")\n\n# QueryError.ts\nfp = os.path.join(base, \"QueryError.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"\"\"    super(\n      `${message} ${results.map((err) => err.path).join(', ')}`,\n      httpStatus.BAD_REQUEST,\n      results,\n    )\"\"\",\n    \"\"\"    super(\n      'QUERY_ERROR',\n      `${message} ${results.map((err) => err.path).join(', ')}`,\n      httpStatus.BAD_REQUEST,\n      results,\n    )\"\"\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated QueryError.ts\")\n\n# ReservedFieldName.ts\nfp = os.path.join(base, \"ReservedFieldName.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"    super(`Field ${field.label} has reserved name '${fieldName}'.`)\",\n    \"    super('RESERVED_FIELD_NAME', `Field ${field.label} has reserved name '${fieldName}'.`)\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated ReservedFieldName.ts\")\n\n# TimestampsRequired.ts\nfp = os.path.join(base, \"TimestampsRequired.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"\"\"    super(\n      `Timestamps are required in the collection ${collection.slug} because you have opted in to Versions.`,\n    )\"\"\",\n    \"\"\"    super(\n      'TIMESTAMPS_REQUIRED',\n      `Timestamps are required in the collection ${collection.slug} because you have opted in to Versions.`,\n    )\"\"\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated TimestampsRequired.ts\")\n\n# UnverifiedEmail.ts\nfp = os.path.join(base, \"UnverifiedEmail.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"\"\"    super(\n      t ? t('error:unverifi