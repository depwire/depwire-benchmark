      # Try to extract message text (first arg)\n        if arg_start < len(content):\n            ch = content[arg_start]\n            if ch == \"'\" or ch == '\"':\n                # Simple string literal\n                end = content.find(ch, arg_start + 1)\n                if end != -1:\n                    message_text = content[arg_start+1:end]\n            elif ch == '`':\n                # Template literal - find closing backtick (simplified)\n                end = content.find('`', arg_start + 1)\n                if end != -1:\n                    message_text = content[arg_start+1:end]\n        \n        # Try to find the status (second arg) - look for comma after first arg\n        # Find the balanced first argument end\n        depth = 0\n        in_string = None\n        j = arg_start\n        first_comma = -1\n        while j < len(content) and j < paren_start + 1000:\n            c = content[j]\n            if in_string:\n                if c == '\\\\':\n                    j += 2\n                    continue\n                if c == in_string:\n                    in_string = None\n            else:\n                if c in (\"'\", '\"', '`'):\n                    in_string = c\n                elif c == '(':\n                    depth += 1\n                elif c == ')':\n                    if depth == 0:\n                        break\n                    depth -= 1\n                elif c == ',' and depth == 0:\n                    if first_comma == -1:\n                        first_comma = j\n                        # Get status text\n                        status_start = j + 1\n                        while status_start < len(content) and content[status_start] in ' \\t\\n\\r':\n                            status_start += 1\n                        # Read until next comma or close paren\n                        status_end = status_start\n                        sd = 0\n                        while status_end < len(content):\n               