NOT_SUPPORTED'\n    if 'not eligible' in msg: return 'NOT_ELIGIBLE'\n    if 'missing' in msg: return 'MISSING_REQUIRED'\n    if 'invalid' in msg: return 'INVALID_INPUT'\n    if 'unverified' in msg: return 'UNVERIFIED_EMAIL'\n    if 'verification' in msg: return 'INVALID_TOKEN'\n    if 'no user' in msg: return 'AUTH_ERROR'\n    if 'incorrect collection' in msg: return 'AUTH_ERROR'\n    if 'upload' in msg or 'file' in msg: return 'FILE_ERROR'\n    if 'failed' in msg and 'sync' in msg: return 'SYNC_ERROR'\n    if 'failed' in msg and 'delete' in msg: return 'DELETE_ERROR'\n    if 'failed' in msg and 'fetch' in msg: return 'FETCH_ERROR'\n    if 'failed' in msg: return 'OPERATION_FAILED'\n    if 'error' in msg: return 'INTERNAL_ERROR'\n    if 'exceed' in msg or 'larger' in msg or 'limit' in msg: return 'REQUEST_TOO_LARGE'\n    if 'simulated' in msg or 'test' in msg: return 'TEST_ERROR'\n    \n    fp = file_path.lower()\n    if 'upload' in fp: return 'UPLOAD_ERROR'\n    if 'auth' in fp: return 'AUTH_ERROR'\n    if 'stagedupload' in fp: return 'UPLOAD_ERROR'\n    \n    if status_text:\n        st = status_text.strip()\n        if st in ('400', 'httpStatus.BAD_REQUEST'): return 'BAD_REQUEST'\n        if st in ('500', 'httpStatus.INTERNAL_SERVER_ERROR'): return 'INTERNAL_ERROR'\n    \n    return 'INTERNAL_ERROR'\n\n\ndef add_error_code_to_new_apierror(content, file_path):\n    result = []\n    i = 0\n    modified = False\n    \n    while i < len(content):\n        idx = content.find(\"new APIError(\", i)\n        if idx == -1:\n            result.append(content[i:])\n            break\n        \n        result.append(content[i:idx])\n        paren_start = idx + len(\"new APIError(\")\n        \n        arg_start = paren_start\n        while arg_start < len(content) and content[arg_start] in ' \\t\\n\\r':\n            arg_start += 1\n        \n        # Extract message text\n        message_text = \"\"\n        status_text = \"\"\n        \n        if arg_start < len(content):\n            ch = content[arg_start]\n            if ch in (\"'\", '\"'):\n                j = arg_start + 1\n                while j < len(content):\n                    if content[j] == '\\\\': j += 2; continue\n                    if content[j] == ch: break\n                    j += 1\n                message_text = content[arg_start+1:j]\n            elif ch == '`':\n                j = arg_start + 1\n                tdepth = 0\n                while j < len(content):\n                    if content[j] == '\\\\': j += 2; continue\n                    if content[j] == '$' and j+1 < len(content) and content[j+1] == '{':\n                        tdepth += 1; j += 2; continue\n                    if content[j] == '}' and tdepth > 0:\n                        tdepth -= 1; j += 1; continue\n                    if content[j] == '`' and tdepth == 0: break\n                    j += 1\n                message_text = content[arg_start+1:j]\n            else:\n                # Variable reference - try to get it\n                j = arg_start\n                while j < len(content) and content[j] not in (',', ')', '\\n', ' '):\n                    j += 1\n                message_text = content[arg_start:j]\n        \n        # Find status (second arg)\n        depth = 0\n        in_str = None\n        j = arg_start\n        while j < len(content) and j < paren_start + 2000:\n            c = content[j]\n            if in_str:\n                if c == '\\\\': j += 2; continue\n                if c == in_str: in_str = None\n            else:\n                if c in (\"'\", '\"', '`'): in_str = c\n                elif c == '(': depth += 1\n                elif c == ')':\n                    if depth == 0: break\n                    depth -= 1\n                elif c == ',' and depth == 0:\n                    ss = j + 1\n                    while ss < len(content) and content[ss] in ' \\t\\n\\r': ss += 1\n                    se = ss\n                    sd = 0; si = None\n                    while se < len(content):\n                        sc = content[se]\n                        if si:\n                            if sc == '\\\\': se += 2; continue\n                            if sc == si: si = None\n                        else:\n                            if sc in (\"'\", '\"', '`'): si = sc\n                            elif sc == '(': sd += 1\n                            elif sc == ')':\n                                if sd == 0: break\n                                sd -= 1\n                            elif sc == ',' and sd == 0: break\n                        se += 1\n                    status_text = content[ss:se].strip()\n                    break\n            j += 1\n        \n        error_code = determine_error_code(message_text, status_text, file_path)\n        \n        after_paren = content[paren_start:arg_start]\n        \n        if '\\n' in after_paren:\n            lines_after = after_paren.split('\\n')\n            indent = lines_after[-1]\n            result.append(f\"new APIError({after_paren}'{error_code}',\\n{indent}\")\n            i = arg_start\n        else:\n            result.append(f\"new APIError('{error_code}', \")\n            i = arg_start\n        \n        modified = True\n    \n    return ''.join(result), modified\n\n\n# Get all files\nresult = subprocess.run(\n    ['rg', '-l', r'new APIError\\(', '--glob', '*.ts', '--glob', '*.tsx', '--glob', '*.mdx', '--glob', '*.md', REPO_ROOT],\n    capture_output=True, text=True\n)\nall_files = [f.strip() for f in result.stdout.strip().split('\\n') if f.strip()]\nall_files = [f for f in all_files if '/.depwire/' not in f]\n\nupdated_count = 0\nfor full_path in sorted(all_files):\n    rel_path = os.path.relpath(full_path, REPO_ROOT)\n    with open(full_path) as f:\n        content = f.read()\n    \n    new_content, modified = add_error_code_to_new_apierror(content, rel_path)\n    \n    if modified:\n        with open(full_path, 'w') as f:\n            f.write