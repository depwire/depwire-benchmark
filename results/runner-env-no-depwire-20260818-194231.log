: c = f.read()\nc = c.replace(\n    \"    super(`Collection ${propertyName} already in use: \\\"${duplicate}\\\"`)\",\n    \"    super('DUPLICATE_COLLECTION', `Collection ${propertyName} already in use: \\\"${duplicate}\\\"`)\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated DuplicateCollection.ts\")\n\n# DuplicateFieldName.ts\nfp = os.path.join(base, \"DuplicateFieldName.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"\"\"    super(\n      `A field with the name '${fieldName}' was found multiple times on the same level. Field names must be unique.`,\n    )\"\"\",\n    \"\"\"    super(\n      'DUPLICATE_FIELD_NAME',\n      `A field with the name '${fieldName}' was found multiple times on the same level. Field names must be unique.`,\n    )\"\"\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated DuplicateFieldName.ts\")\n\n# DuplicateGlobal.ts\nfp = os.path.join(base, \"DuplicateGlobal.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"    super(`Global label \\\"${config.label}\\\" is already in use`)\",\n    \"    super('DUPLICATE_GLOBAL', `Global label \\\"${config.label}\\\" is already in use`)\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated DuplicateGlobal.ts\")\n\n# ErrorDeletingFile.ts\nfp = os.path.join(base, \"ErrorDeletingFile.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"\"\"    super(\n      t ? t('error:deletingFile') : en.translations.error.deletingFile,\n      httpStatus.INTERNAL_SERVER_ERROR,\n    )\"\"\",\n    \"\"\"    super(\n      'ERROR_DELETING_FILE',\n      t ? t('error:deletingFile') : en.translations.error.deletingFile,\n      httpStatus.INTERNAL_SERVER_ERROR,\n    )\"\"\")\nwith open(fp, 'w') as f: f.write(c)\nprint(\"Updated ErrorDeletingFile.ts\")\n\n# MissingCollectionLabel.ts\nfp = os.path.join(base, \"MissingCollectionLabel.ts\")\nwith open(fp) as f: c = f.read()\nc = c.replace(\n    \"    super('payload.config.collection object is missing label')\",\n    \"    super('MISS