IDDEN',\n        'httpStatus.NOT_FOUND': 'NOT_FOUND',\n        'httpStatus.INTERNAL_SERVER_ERROR': 'INTERNAL_ERROR',\n        'httpStatus.REQUEST_ENTITY_TOO_LARGE': 'REQUEST_TOO_LARGE',\n    }\n    \n    # Try to find a status code in the args (second arg after the message)\n    # First, let's find the message arg end\n    # The message is the first arg - find its end\n    \n    # Simple heuristic: look for status codes in the text\n    for pattern, code in status_patterns.items():\n        if pattern in args_text:\n            return code\n    \n    # Check file-specific context\n    if 'response.status' in args_text or 'res?.status' in args_text:\n        return 'EXTERNAL_ERROR'\n    \n    # Default\n    return 'INTERNAL_ERROR'\n\ndef process_file(filepath):\n    with open(filepath, 'r') as f:\n        content = f.read()\n    \n    # Find all 'new APIError(' occurrences\n    pattern = 'new APIError('\n    offset = 0\n    modified = False\n    \n    while True:\n        idx = content.find(pattern, offset)\n        if idx == -1:\n            break\n        \n        paren_start = idx + len(pattern) - 1  # position of '('\n        paren_end = find_matching_paren(content, paren_start)\n        if paren_end == -1:\n            offset = idx + len(pattern)\n            continue\n        \n        args_text = content[paren_start+1:paren_end]\n        error_code = determine_error_code(args_text, filepath)\n        \n        # Insert error code as first argument\n        # Find the first non-whitespace after '('\n        after_paren = content[paren_start+1:]\n        \n        # Check if the content after ( starts with whitespace/newline\n        leading = ''\n        j = 0\n        while j < len(after_paren) and after_paren[j] in ' \\t\\n':\n            leading += after_paren[j]\n            j += 1\n        \n        if '\\n' in leading:\n            # Multi-line: insert error code on a new line with proper indentation\n            # Find the indentation of the next line\n            newline_pos = leading.rfind('\\n')\n            indent = leading[newline_pos+1:]\n            insert_text = f\"\\n{indent}'{error_code}',\"\n            content = content[:paren_start+1] + insert_text + content[paren_start+1:]\n        else:\n            # Single-line or same-line args\n            insert_text = f\"'{error_code}', \"\n            content = content[:paren_start+1] + insert_text + content[paren_start+1:]\n        \n        modified = True\n        offset = idx + len(pattern) + len(insert_text)\n    \n    if modified:\n        with open(filepath, 'w') as f:\n            f.write(content)\n        print(f\"Updated: {filepath}\")\n    \n    return modified\n\n# List of files to process (excluding node_modules and error subclass files)\nimport subprocess\nresult = subprocess.run(\n    ['grep', '-rl', 'new APIError(', '--include=*.ts', '.'],\n    capture_output=True, text=True\n)\nfiles = [f.strip() for f in result.stdout.strip().split('\\n') if f.strip()]\n\nskip_suffixes = [\n    'src/errors/Forbidden.ts',\n    'src/errors/NotFound.ts',\n    'src/errors/ValidationError.ts',\n    'src/errors/AuthenticationError.ts',\n    'src/errors/UnauthorizedError.ts',\n    'src/errors/Locked.ts',\n    'src/errors/LockedAuth.ts',\n    'src/errors/QueryError.ts',\n    'src/errors/InvalidConfiguration.ts',\n    'src/errors/InvalidSchema.ts',\n    'src/errors/FileRetrievalError.ts',\n    'src/errors/TimestampsRequired.ts',\n    'src/errors/InvalidFieldJoin.ts',\n    'src/errors/MissingFieldInputOptions.ts',\n    'src/errors/ErrorDeletingFile.ts',\n    'src/errors/MissingCollectionLabel.ts',\n    'src/errors/DuplicateFieldName.ts',\n    'src/errors/DuplicateGlobal.ts',\n    'src/errors/ReservedFieldName.ts',\n    'src/errors/MissingFile.ts',\n    'src/errors/MissingFieldType.ts',\n    'src/errors/InvalidFieldRelationship.ts',\n    'src/errors/UnverifiedEmail.ts',\n    'src/errors/InvalidFieldName.ts',\n    'src/errors/MissingEditorProp.ts',\n    'src/errors/DuplicateCollection.ts',\n    'src/errors/FileUploadError.ts',\n    'src/errors/APIError.ts',\n]\n\ncount = 0\nfor f in files:\n    # Skip node_modules\n    if 'node_modules' in f:\n        continue\n    # Skip error subclass files\n    skip = False\n    for suffix in skip_suffixes:\n        if f.endswith(suffix):\n            skip = True\n            break\n    if skip:\n        continue\n    \n    if process_file(f):\n        count += 1\n\nprint(f\"\\nTotal files updated: {count}\")\nPYEOF","description":"Update all new APIError() call sites with error codes across the monorepo","timeout":60000},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2660,"cache_read_input_tokens":63901,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2660},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"844baaff-1de5-4948-95d3-89068fb7b346","uuid":"10818700-9ad1-4e7e-be36-a498c2ff26b5"}
