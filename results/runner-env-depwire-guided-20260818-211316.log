{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LqQKax7jeBJgJmhP38LPrA","type":"tool_result","content":"     1→import { status as httpStatus } from 'http-status'\n     2→\n     3→/** @deprecated Use `instanceof APIError` instead of name comparison. */\n     4→export const APIErrorName = 'APIError'\n     5→\n     6→class ExtendableError<TData extends object = { [key: string]: unknown }> extends Error {\n     7→  data: TData\n     8→\n     9→  isOperational: boolean\n    10→\n    11→  isPublic: boolean\n    12→\n    13→  status: number\n    14→\n    15→  constructor(message: string, status: number, data: TData, isPublic: boolean) {\n    16→    super(message, {\n    17→      // show data in cause\n    18→      cause: data,\n    19→    })\n    20→    this.name = this.constructor.name\n    21→    this.message = message\n    22→    this.status = status\n    23→    this.data = data\n    24→    this.isPublic = isPublic\n    25→    this.isOperational = true // This is required since bluebird 4 doesn't append it anymore.\n    26→    Error.captureStackTrace(this, this.constructor)\n    27→  }\n    28→}\n    29→\n    30→/**\n    31→ * Class representing an API error.\n    32→ * @extends ExtendableError\n    33→ */\n    34→export class APIError<\n    35→  TData extends null | object = { [key: string]: unknown } | null,\n    36→  // @ts-expect-error - vestiges of when tsconfig was not strict. Feel free to improve\n    37→> extends ExtendableError<TData> {\n    38→  /**\n    39→   * Creates an API error.\n    40→   * @param {string} message - Error message.\n    41→   * @param {number} status - HTTP status code of error.\n    42→   * @param {object} data - response data to be returned.\n    43→   * @param {boolean} isPublic - Whether the message should be visible to user or not.\n    44→   */\n    45→  constructor(\n    46→    message: string,\n    47→    status: number = httpStatus.INTERNAL_SERVER_ERROR,\n    48→    data: TData = null!,\n    49→    isPu