Type, Model }\n    54→}\n    55→\n    56→type BaseGetGlobalArgs = {\n    57→  adapter: MongooseAdapter\n    58→  globalSlug: string\n    59→}\n    60→\n    61→interface GetGlobal {\n    62→  (args: { versions?: false | undefined } & BaseGetGlobalArgs): {\n    63→    globalConfig: SanitizedGlobalConfig\n    64→    Model: GlobalModel\n    65→  }\n    66→  (args: { versions?: true } & BaseGetGlobalArgs): {\n    67→    globalConfig: SanitizedGlobalConfig\n    68→    Model: CollectionModel\n    69→  }\n    70→}\n    71→\n    72→export const getGlobal: GetGlobal = ({ adapter, globalSlug, versions = false }) => {\n    73→  const globalConfig = adapter.payload.config.globals.find((each) => each.slug === globalSlug)\n    74→\n    75→  if (!globalConfig) {\n    76→    throw new APIError(\n    77→      'NOT_FOUND',\n    78→      `ERROR: Failed to retrieve global with the slug \"${globalSlug}\". Does not exist.`,\n    79→    )\n    80→  }\n    81→\n    82→  if (versions) {\n    83→    const Model = adapter.versions[globalSlug]\n    84→\n    85→    if (!Model) {\n    86→      throw new APIError(\n    87→      'NOT_FOUND',\n    88→        `ERROR: Failed to retrieve global version model with the slug \"${globalSlug}\". Does not exist.`,\n    89→      )\n    90→    }\n    91→\n    92→    return { globalConfig, Model }\n    93→  }\n    94→\n    95→  return { globalConfig, Model: adapter.globals } as any\n    96→}\n    97→"}]},"parent_tool_use_id":null,"session_id":"8a4a3c06-cf0c-4ac2-8dc9-fd38ad8b6415","uuid":"ca875a8f-3214-4b26-9a03-d106f7b21799","tool_use_result":{"type":"text","file":{"filePath":"/Users/atefataya/Developer/depwire-benchmark-v2/repo/packages/db-mongodb/src/utilities/getEntity.ts","content":"import type { Collection, SanitizedCollectionConfig, SanitizedGlobalConfig } from 'payload'\n\nimport { APIError } from 'payload'\n\nimport type { MongooseAdapter } from '../index.js'\nimport type { CollectionModel, GlobalModel } from '../types.js'\n\nexport const getCollection = ({\n  adapter,\n  collectionSlug,\n  versions = false,\n}: {\n  adapter: MongooseAdapter\n  collectionSlug: string\n  versions?: boolean\n}): {\n  collectionConfig: SanitizedCollectionConfig\n  customIDType: Collection['customIDType']\n\n  Model: CollectionModel\n} => {\n  const collection = adapter.payload.collections[collectionSlug]\n\n  if (!collection) {\n    throw new APIError(\n      'NOT_FOUND',\n      `ERROR: Failed to retrieve collection with the slug \"${collectionSlug}\". Does not exist.`,\n    )\n  }\n\n  if (versions) {\n    const Model = adapter.versions[collectionSlug]\n\n    if (!Model) {\n      throw new APIError(\n      'NOT_FOUND',\n        `ERROR: Failed to retrieve collection version model with the slug \"${collectionSlug}\". Does not exist.`,\n      )\n    }\n\n    return { collectionConfig: collection.config, customIDType: collection.customIDType, Model }\n  }\n\n  const Model = adapter.collections[collectionSlug]\n\n  if (!Model) {\n    throw new APIError(\n      'NOT_FOUND',\n      `ERROR: Failed to retrieve collection model with the slug \"${collectionSlug}\". Does not exist.`,\n    )\n  }\n\n  return { collectionConfig: collection.config, customIDType: collection.customIDType, Model }\n}\n\ntype BaseGetGlobalArgs = {\n  adapter: MongooseAdapter\n  globalSlug: string\n}\n\ninterface GetGlobal {\n  (args: { versions?: false | undefined } & BaseGetGlobalArgs): {\n    globalConfig: SanitizedGlobalConfig\n    Model: GlobalModel\n  }\n  (args: { versions?: true } & BaseGetGlobalArgs): {\n    globalConfig: SanitizedGlobalConfig\n    Model: CollectionModel\n  }\n}\n\nexport const getGlobal: GetGlobal = ({ adapter, globalSlug, versions = false }) => {\n  const globalConfig = adapter.payload.config.globals.find((each) => each.slug === globalSlug)\n\n  if (!globalConfig) {\n    throw new APIError(\n      'NOT_FOUND',\n      `ERROR: Failed to retrieve global with the slug \"${globalSlug}\". Does not exist.`,\n    )\n  }\n\n  if (versions) {\n    const Model = adapter.versions[globalSlug]\n\n    if (!Model) {\n      throw new APIError(\n      'NOT_FOUND',\n        `ERROR: Failed to retrieve global version model with the slug \"${globalSlug}\". Does not exist.`,\n      )\n    }\n\n    return { globalConfig, Model }\n  }\n\n  return { globalConfig, Model: adapter.globals } as any\n}\n","numLines":97,"startLine":1,"totalLines":97}}}
