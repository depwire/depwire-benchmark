{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AGiNQrdnVZj3Hr912wBrRx","type":"tool_result","content":"     1→import type { PayloadRequest } from '../types/index.js'\n     2→import type { UploadInstructions } from './types.js'\n     3→\n     4→import { APIError } from '../errors/APIError.js'\n     5→import { getStagedFile } from './stagedUpload.js'\n     6→\n     7→export const getFileFromUploadInstructions = async ({\n     8→  collectionSlug,\n     9→  file,\n    10→  req,\n    11→}: {\n    12→  collectionSlug: string\n    13→  file: UploadInstructions['file']\n    14→  req: PayloadRequest\n    15→}): Promise<NonNullable<PayloadRequest['file']>> => {\n    16→  if (\n    17→    !file ||\n    18→    typeof file !== 'object' ||\n    19→    !file.uploadReference ||\n    20→    typeof file.uploadReference !== 'object'\n    21→  ) {\n    22→    throw new APIError('Invalid upload reference.', 400)\n    23→  }\n    24→\n    25→  /**\n    26→   * Handlers fetch files uploaded to a storage provider. An uploadId points to a temporary file\n    27→   * already stored by Payload, so no handler is needed.\n    28→   */\n    29→  if ('uploadId' in file.uploadReference) {\n    30→    return getStagedFile({ collectionSlug, req, uploadReference: file.uploadReference })\n    31→  }\n    32→\n    33→  const uploadConfig = req.payload.collections[collectionSlug]!.config.upload\n    34→\n    35→  if (!uploadConfig || !uploadConfig.handlers) {\n    36→    throw new APIError('uploadConfig.handlers is not present for ' + collectionSlug)\n    37→  }\n    38→\n    39→  let response: null | Response = null\n    40→  let error: unknown\n    41→\n    42→  for (const handler of uploadConfig.handlers) {\n    43→    try {\n    44→      const result = await handler(req, {\n    45→        doc: null!,\n    46→        params: {\n    47→          collection: collectionSlug,\n    48→          filename: file.filename,\n    49→          uploadReference: file.uploadReference,\n    50→        },\n    51→      })\n    52→      if (result) {\n    53→        response = result\n    54→        /**\n    55→         * - If a handler returns a Response, the response will be sent to the client and no further handlers will be run.\n    56→         * - If a handler returns null, the next handler will be run.\n    57→         *\n    58→         * @see packages/payload/src/uploads/types.ts\n    59→         */\n    60→        break\n    61→      }\n    62→    } catch (err) {\n    63→      error = err\n    64→    }\n    65→  }\n    66→\n    67→  if (!response) {\n    68→    if (error) {\n    69→      req.payload.logger.error(error)\n    70→    }\n    71→\n    72→    throw new APIError('Expected response from the upload handler.')\n    73→  }\n    74→\n    75→  if (response.status >= 300 && response.status < 400) {\n    76→    const redirectUrl = response.headers.get('Location')\n    77→    if (redirectUrl) {\n    78→      response = await fetch(redirectUrl)\n    79→    }\n    80→  }\n    81→\n    82→  return {\n    83→    name: file.filename,\n    84→    data: Buffer.from(await response.arrayBuffer()),\n    85→    mimetype: response.headers.get('Content-Type') || file.mimeType,\n    86→    size: file.size,\n    87→    uploadReference: file.uploadReference,\n    88→  }\n    89→}\n    90→"}]},"parent_tool_use_id":null,"session_id":"8a4a3c06-cf0c-4ac2-8dc9-fd38ad8b6415","uuid":"3e23704b-269c-4b7e-8b04-0a7c7cac702b","tool_use_result":{"type":"text","file":{"filePath":"/Users/atefataya/Developer/depwire-benchmark-v2/repo/packages/payload/src/uploads/getFileFromUploadInstructions.ts","content":"import type { PayloadRequest } from '../types/index.js'\nimport type { UploadInstructions } from './types.js'\n\nimport { APIError } from '../errors/APIError.js'\nimport { getStagedFile } from './stagedUpload.js'\n\nexport const getFileFromUploadInstructions = async ({\n  collectionSlug,\n  file,\n  req,\n}: {\n  collectionSlug: string\n  file: UploadInstructions['file']\n  req: PayloadRequest\n}): Promise<NonNullable<PayloadRequest['file']>> => {\n  if (\n    !file ||\n    typeof file !== 'object' ||\n    !file.uploadReference ||\n    typeof file.uploadReference !== 'object'\n  ) {\n    throw new APIError('Invalid upload reference.', 400)\n  }\n\n  /**\n   * Handlers fetch files uploaded to a storage provider. An uploadId points to a temporary file\n   * already stored by Payload, so no handler is needed.\n   */\n  if ('uploadId' in file.uploadReference) {\n    return getStagedFile({ collectionSlug, req, uploadReference: file.uploadReference })\n  }\n\n  const uploadConfig = req.payload.collections[collectionSlug]!.config.upload\n\n  if (!uploadConfig || !uploadConfig.handlers) {\n    throw new APIError('uploadConfig.handlers is not present for ' + collectionSlug)\n  }\n\n  let response: null | Response = null\n  let error: unknown\n\n  for (const handler of uploadConfig.handlers) {\n    try {\n      const result = await handler(req, {\n        doc: null!,\n        params: {\n          collection: collectionSlug,\n          filename: file.filename,\n          uploadReference: file.uploadReference,\n        },\n      })\n      if (result) {\n        response = result\n        /**\n         * - If a handler returns a Response, the response will be sent to the client and no further handlers will be run.\n         * - If a handler returns null, the next handler will be run.\n         *\n         * @see packages/payload/src/uploads/types.ts\n         */\n        break\n      }\n    } catch (err) {\n      error = err\n    }\n  }\n\n  if (!response) {\n    if (error) {\n      req.payload.logger.error(error)\n    }\n\n    throw new APIError('Expected response from the upload handler.')\n  }\n\n  if (response.status >= 300 && response.status < 400) {\n    const redirectUrl = response.headers.get('Location')\n    if (redirectUrl) {\n      response = await fetch(redirectUrl)\n    }\n  }\n\n  return {\n    name: file.filename,\n    data: Buffer.from(await response.arrayBuffer()),\n    mimetype: response.headers.get('Content-Type') || file.mimeType,\n    size: file.size,\n    uploadReference: file.uploadReference,\n  }\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
