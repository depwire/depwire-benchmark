\n    overrideAccess,\n    req: await createLocalReq(options as CreateLocalReqOptions, payload),\n    trash,\n    where,\n  })\n}\n","structuredPatch":[{"oldStart":72,"oldLines":6,"newStart":72,"newLines":7,"lines":[" ","   if (!collection) {","     throw new APIError(","+      'COLLECTION_NOT_FOUND',","       `The collection with slug ${String(collectionSlug)} can't be found. Count Operation.`,","     )","   }"]}],"userModified":false,"replaceAll":false}}
