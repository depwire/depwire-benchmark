{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GXHw8S9KxPBiZCKwASbX4x","type":"tool_result","content":"     1→import type {\n     2→  AuthCollectionSlug,\n     3→  AuthOperationsFromCollectionSlug,\n     4→  Payload,\n     5→  RequestContext,\n     6→} from '../../../index.js'\n     7→import type { PayloadRequest } from '../../../types/index.js'\n     8→\n     9→import { APIError } from '../../../errors/index.js'\n    10→import { createLocalReq } from '../../../utilities/createLocalReq.js'\n    11→import { unlockOperation } from '../unlock.js'\n    12→\n    13→export type Options<TSlug extends AuthCollectionSlug> = {\n    14→  collection: TSlug\n    15→  context?: RequestContext\n    16→  data: AuthOperationsFromCollectionSlug<TSlug>['unlock']\n    17→  overrideAccess: boolean\n    18→  req?: Partial<PayloadRequest>\n    19→}\n    20→\n    21→export async function unlockLocal<TSlug extends AuthCollectionSlug>(\n    22→  payload: Payload,\n    23→  options: Options<TSlug>,\n    24→): Promise<boolean> {\n    25→  const { collection: collectionSlug, data, overrideAccess = true } = options\n    26→\n    27→  const collection = payload.collections[collectionSlug]\n    28→\n    29→  if (!collection) {\n    30→    throw new APIError(\n    31→      `The collection with slug ${String(collectionSlug)} can't be found. Unlock Operation.`,\n    32→    )\n    33→  }\n    34→\n    35→  return unlockOperation<TSlug>({\n    36→    collection,\n    37→    data,\n    38→    overrideAccess,\n    39→    req: await createLocalReq(options, payload),\n    40→  })\n    41→}\n    42→"}]},"parent_tool_use_id":null,"session_id":"8a4a3c06-cf0c-4ac2-8dc9-fd38ad8b6415","uuid":"293e16b7-3632-4668-b627-6930656c1ef5","tool_use_result":{"type":"text","file":{"filePath":"/Users/atefataya/Developer/depwire-benchmark-v2/repo/packages/payload/src/auth/operations/local/unlock.ts","content":"import type {\n  AuthCollectionSlug,\n  AuthOperationsFromCollectionSlug,\n  Payload,\n  RequestContext,\n} from '../../../index.js'\nimport type { PayloadRequest } from '../../../types/index.js'\n\nimport { APIError } from '../../../errors/index.js'\nimport { createLocalReq } from '../../../utilities/createLocalReq.js'\nimport { unlockOperation } from '../unlock.js'\n\nexport type Options<TSlug extends AuthCollectionSlug> = {\n  collection: TSlug\n  context?: RequestContext\n  data: AuthOperationsFromCollectionSlug<TSlug>['unlock']\n  overrideAccess: boolean\n  req?: Partial<PayloadRequest>\n}\n\nexport async function unlockLocal<TSlug extends AuthCollectionSlug>(\n  payload: Payload,\n  options: Options<TSlug>,\n): Promise<boolean> {\n  const { collection: collectionSlug, data, overrideAccess = true } = options\n\n  const collection = payload.collections[collectionSlug]\n\n  if (!collection) {\n    throw new APIError(\n      `The collection with slug ${String(collectionSlug)} can't be found. Unlock Operation.`,\n    )\n  }\n\n  return unlockOperation<TSlug>({\n    collection,\n    data,\n    overrideAccess,\n    req: await createLocalReq(options, payload),\n  })\n}\n","numLines":42,"startLine":1,"totalLines":42}}}
